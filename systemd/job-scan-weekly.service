[Unit]
Description=Weekly job scan incl. hiring-without-whiteboards companies
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Developer/job-scan
# Same lock and sleep inhibitor as the daily run (see job-scan.service).
ExecStart=systemd-inhibit --what=sleep --mode=block --why="job-scan weekly run" flock %h/Developer/job-scan/data/.scan.lock %h/Developer/job-scan/weekly.sh
# Make notify-send able to reach the user session
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/%U
# Resolve (~4 min) plus a full scan scoring up to 150 postings at ~25-40 s each:
# the old 1 h limit killed it at 70/150 on 2026-11-09.
TimeoutStartSec=4h
StandardOutput=journal
StandardError=journal
